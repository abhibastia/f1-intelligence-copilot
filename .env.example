# Copy to .env and edit, then `set -a && source .env && set +a`.
#
# Nothing here is secret. Jolpica-F1, Wikimedia and Open-Meteo are all free and
# keyless — the only credential in this project is the Lakebase connection URL,
# which lives in a Databricks secret and is never stored here. See
# setup_secrets.py if you need to provision that scope.

# ─── required ───────────────────────────────────────────────────────────
# Your Databricks CLI profile. There is no default and the scripts will not
# guess one; they list what you have configured and stop.
#   databricks auth profiles
#   databricks auth login --host https://<workspace>.cloud.databricks.com --profile <name>
DATABRICKS_PROFILE=

# ─── the medallion pipeline ──────────────────────────────────────────────
# The Unity Catalog catalog. Must already exist — Free Edition cannot create
# catalogs over the API, so make it in the UI with Default storage.
F1_CATALOG=f1
F1_VOLUME_SCHEMA=raw
F1_VOLUME_NAME=landing

# Local directory holding backfilled JSON before it is uploaded, and the race
# spine harvest/races.py reads to build documents, embeddings and predictions
# against. One directory now serves both halves of the platform.
F1_LOCAL_LANDING=./landing
F1_LANDING_DIR=./landing

# Bundle target: dev or prod. prod writes to a separate catalog (f1_prod) that
# you must create first.
F1_TARGET=dev

# BUNDLE_VAR_<name> overrides a databricks.yml default without editing it.
# Find your warehouse with `databricks warehouses list --profile <name>`.
# BUNDLE_VAR_warehouse_id=
# BUNDLE_VAR_catalog=f1

# ─── the Lakebase / RAG / agent layer ────────────────────────────────────
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Where the Postgres connection URL lives (names only, never the value).
LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=lakebase-url

# Escape hatch for running against a plain Postgres with no Databricks auth.
# Leave unset in normal use so the secret scope is used.
# LAKEBASE_URL=postgresql://role:password@host:5432/databricks_postgres?sslmode=require

# Must match the model that built the stored vectors, or search returns
# nonsense rather than erroring.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
HF_HOME=/tmp/.cache/huggingface
SENTENCE_TRANSFORMERS_HOME=/tmp/.cache/huggingface

# Wikipedia's User-Agent policy requires a contact route; anonymous-looking
# clients are throttled hard (HTTP 429 after ~10 requests).
WIKI_USER_AGENT=f1-intelligence-copilot/1.0 (https://github.com/<you>/f1-intelligence-copilot) contact via GitHub issues

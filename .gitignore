# --- Python -----------------------------------------------------------------
__pycache__/
*.py[codz]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Environments -------------------------------------------------------------
.venv/
venv/
env/
.env
.env.*
!.env.example

# --- Credentials — never commit ---------------------------------------------
*.pem
*.key
*.p12
.databrickscfg
id_rsa*

# --- Harvested / backfilled API payloads -------------------------------------
# Regenerated by src/ingestion/ingest.py and uploaded to the UC Volume, which is
# where the pipeline actually reads them from. Reproducible from the API, so
# committing it would trade repository size for nothing.
landing/

# --- Databricks CLI sync / bundle state --------------------------------------
# `databricks sync` writes state next to a synced directory; `databricks bundle
# deploy` writes deployment ids and snapshots. Both are specific to one
# workspace and one user, and would produce spurious diffs for anyone deploying
# from their own.
.databricks/

# --- Generated app payload: DELIBERATELY NOT IGNORED -------------------------
# scripts/build_app.sh copies f1lake/{schema,embedder,__init__}.py and
# mcp_server/f1_broker.py into each app directory, because a Databricks App
# deploys from a single source path and a sibling package is not importable at
# runtime.
#
# These copies were ignored at first, in the standalone f1-strategy-copilot
# project. That was wrong: `databricks sync` honours .gitignore, so ignoring
# them silently stripped f1lake/ out of the deployment and the app failed on
# `from f1lake import schema` before serving a request. There is no way to have
# the payload deployed but untracked, so the copies stay committed and
# build_app.sh regenerates them — run it before committing app/ or mcp_server/
# changes; `git diff` then shows any drift instead of hiding it.

# --- Warehouse query cache ----------------------------------------------------
# Gold marts pulled from Delta by f1lake/seed_gold.py, cached so a failed seed
# does not re-spend a warehouse query. Derived data — Delta is the source of
# truth. Regenerate with `seed_gold.py --refresh`.
data/f1_driver_performance.json
data/f1_championship.json
data/f1_race_weather.json
data/f1_race_strategy_summary.json
data/f1_lap_pace.json
data/f1_constructor_standings.json

# Lap times: ~1,133 rows per race across dozens of races. Large, slow to fetch,
# and fully regenerable with `python -m harvest.laps`. Pit stops ARE committed —
# small, and what the stint reconstruction depends on.
data/laps/

# Harvested API output more generally. Regenerated by harvest/ (see README).
# The demo transcripts are kept — evidence, not intermediate data.
data/*
!data/demo_transcripts.json

# --- Generated presentation output -------------------------------------------
build/

# --- Editors and OS -----------------------------------------------------------
.idea/
.vscode/
# .claude/settings.json is the project's tracked, shared hook/permission
# config; .claude/settings.local.json (and everything else under .claude/)
# stays personal and ignored.
.claude/*
!.claude/settings.json
.DS_Store
